<Window x:Class="Libreria.Lector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="Lector" Height="465" Width="800"
        Activated = "Window_Activated">
    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="/madera.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="427*"/>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        <Label x:Name="lbl_titulo" Content="Lector" HorizontalAlignment="Left" Margin="8,8,0,0" VerticalAlignment="Top" FontSize="36" FontWeight="Bold" FontFamily="Franklin Gothic Medium" Height="51" Width="106" Grid.RowSpan="2"/>
        <Label x:Name="lbl_add_name" Content="Nombre:" HorizontalAlignment="Left" Margin="12,39,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="70" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_reader_input" HorizontalAlignment="Left" Margin="87,41,0,0" TextWrapping="Wrap" Text="Nombre..." VerticalAlignment="Top" Width="255" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Label x:Name="lbl_add_lastname1" Content="Apellido Paterno:" HorizontalAlignment="Left" Margin="12,71,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="128" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_readlast1_input" HorizontalAlignment="Left" Margin="143,73,0,0" TextWrapping="Wrap" Text="Paterno..." VerticalAlignment="Top" Width="199" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Label x:Name="lbl_add_lastname2" Content="Apellido Materno: " HorizontalAlignment="Left" Margin="12,101,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="136" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_readlast2_input" HorizontalAlignment="Left" Margin="143,105,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="199" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Label x:Name="lbl_add_cellphone" Content="Número de Telefono:" HorizontalAlignment="Left" Margin="390,39,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="154" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_readphone_input" HorizontalAlignment="Left" Margin="546,40,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="225" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Label x:Name="lbl_add_email" Content="Correo Electrónico:" HorizontalAlignment="Left" Margin="388,71,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="139" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_reademail_input" HorizontalAlignment="Left" Margin="527,72,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="244" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Label x:Name="lbl_add_adress_Copy" Content="Domicilio:" HorizontalAlignment="Left" Margin="388,103,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="79" Grid.Row="1"/>
        <TextBox x:Name="txtbx_add_readaddress_input" HorizontalAlignment="Left" Margin="472,104,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="299" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27" Grid.Row="1"/>
        <Button x:Name="btn_add_reader" Content="Agrega" HorizontalAlignment="Left" Margin="335,140,0,0" VerticalAlignment="Top" Height="38" Width="91" Background="#FF72FEB6" BorderBrush="#FF084004" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Grid.Row="1" Click="btn_add_reader_Click"/>
        <ListBox x:Name="lstbx_allReaders" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="39,184,31,73" Grid.Row="1"/>
        <Label x:Name="lbl_all_readers" Content="Todos los Lectores" HorizontalAlignment="Left" Margin="35,152,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="153" FontWeight="Bold" Grid.Row="1"/>
        <Button x:Name="btn_delete_reader" Content="Eliminar" HorizontalAlignment="Left" Margin="284,378,0,10" Width="92" Background="#FFF57F7F" BorderBrush="#FF520303" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Grid.Row="1" Click="btn_delete_reader_Click"/>
        <Button x:Name="btn_update_reader" Content="Actualizar" HorizontalAlignment="Left" Margin="400,378,0,10" Width="92" Background="#FF7FDBF5" BorderBrush="#FF09052D" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Grid.Row="1" Click="btn_update_reader_Click"/>
        <DockPanel>
            <Menu DockPanel.Dock ="Top" Margin="0, 0, 0, -10">
                <MenuItem Header="Archivo">
                    <MenuItem Header="Regresar a Prestamo" Name="men_Back" Click="botonPrestamo_Click"/>
                </MenuItem>
                <MenuItem Header="Ayuda" Name="men_help" Click="men_help_Click" />
            </Menu>
        </DockPanel>
        <Image HorizontalAlignment="Left" Height="31" Margin="119,10,0,0" VerticalAlignment="Top" Width="29" Source="/download-PhotoRoom.png-PhotoRoom (1).png" Grid.Row="1"/>
        <Image HorizontalAlignment="Left" Height="51" Margin="492,378,0,0" VerticalAlignment="Top" Width="58" Source="/istockphoto-587954006-170667a-PhotoRoom.png-PhotoRoom.png" Grid.Row="1"/>
        <Image HorizontalAlignment="Left" Height="47" Margin="232,380,0,0" VerticalAlignment="Top" Width="60" Source="/borrar-plugins-wordpress.png" Grid.Row="1"/>
        <Image HorizontalAlignment="Left" Height="59" Margin="428,135,0,0" VerticalAlignment="Top" Width="48" Source="/Basic_Ui_(235)-PhotoRoom.png-PhotoRoom.png" Grid.Row="1"/>
    </Grid>
</Window>
