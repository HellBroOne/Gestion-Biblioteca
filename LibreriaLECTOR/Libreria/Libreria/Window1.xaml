<Window x:Class="Libreria.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="Blibliotecario" Height="450" Width="800"
        Activated = "Window_Activated">

    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="/madera.png"/>
        </Grid.Background>
        <DockPanel Margin="0,-10,0,411" RenderTransformOrigin="0.529,-4.307">
            <Menu DockPanel.Dock ="Top" Margin="0, 0, 0, -10" Height="22" RenderTransformOrigin="0.496,-3.245">
                <MenuItem Header="Archivo">
                    <MenuItem Header="Regresar a Prestamo" Name="menuRegresar" Click="botonPrestamo_Click"/>
                </MenuItem>
                <MenuItem Header="Ayuda" Name="men_help" Click="menuAyuda_Click" />
            </Menu>
        </DockPanel>

        <Grid Margin="0,29,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="280*"/>
                <RowDefinition Height="131*"/>
            </Grid.RowDefinitions>

            <Label x:Name="title_regLib" Content="Registro Bibliotecario" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="48" Width="343" FontSize="36" FontFamily="Franklin Gothic Medium" FontWeight="Bold"/>
            <Label x:Name="texto_nombre" Content="Nombre: " HorizontalAlignment="Left" Margin="55,64,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="74"/>
            <Label x:Name="texto_spaterno" Content="Apellido Paterno: " HorizontalAlignment="Left" Margin="55,94,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="133"/>
            <Label x:Name="texto_smaterno" Content="Apellido Materno: " HorizontalAlignment="Left" Margin="55,127,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="136"/>
            <Label x:Name="texto_telefono" Content="Teléfono: " HorizontalAlignment="Left" Margin="55,151,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="77"/>
            <Label x:Name="texto_email" Content="Correo Electrónico: " HorizontalAlignment="Left" Margin="53,182,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="144"/>
            <Label x:Name="texto_rfc" Content="RFC: " HorizontalAlignment="Left" Margin="55,210,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="45"/>
            <TextBox x:Name="input_nombre" HorizontalAlignment="Left" Margin="189,69,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontStyle="Italic" FontSize="16" Height="23" />
            <TextBox x:Name="input_apaterno" HorizontalAlignment="Left" Margin="189,100,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontSize="16" FontStyle="Italic" Height="23"/>
            <TextBox x:Name="input_amaterno" HorizontalAlignment="Left" Margin="189,131,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontSize="16" Height="23"/>
            <TextBox x:Name="input_telefono" HorizontalAlignment="Left" Margin="189,158,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontSize="16" Height="23" />
            <TextBox x:Name="input_email" HorizontalAlignment="Left" Margin="189,188,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontSize="16" Height="23"/>
            <TextBox x:Name="input_rfc" HorizontalAlignment="Left" Margin="189,218,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="201" BorderBrush="Black" FontSize="16" Height="23"/>
            <Button x:Name="button_register" Content="Agregar" HorizontalAlignment="Left" Margin="163,10,0,0" VerticalAlignment="Top" Height="40" Width="100" Click="Button_Click" Background="#FF84F1BD" Grid.Row="1" FontWeight="Bold" FontSize="16" BorderBrush="#FF02420A" BorderThickness="2,2,2,2"/>
            <ListBox x:Name="todosLosBibliotecarios" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="428,54,44,89" Grid.RowSpan="2"/>
            <Button x:Name="button_actualizar" Content="Actualizar" HorizontalAlignment="Left" Margin="471,54,0,0" VerticalAlignment="Top" Click="Button_Click_1" Height="39" Width="107" Background="#FF6EE8F7" Grid.Row="1" BorderThickness="2,2,2,2" BorderBrush="#FF072550" FontWeight="Bold" FontSize="16"/>
            <Button Content="Eliminar" HorizontalAlignment="Left" Margin="611,54,0,0" VerticalAlignment="Top" Height="40" Width="101" Background="#FFFD8383" Click="Button_Click_2" Grid.Row="1" FontWeight="Bold" BorderBrush="#FF4D0505" BorderThickness="2,2,2,2" FontSize="16"/>
            <Label x:Name="label_bibliotecarios" Content="Todos los bibliotecarios " HorizontalAlignment="Left" Margin="428,18,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="174"/>
            <Image HorizontalAlignment="Left" Height="69" Margin="358,0,0,0" VerticalAlignment="Top" Width="65" Source="/264745.png"/>
            <Image HorizontalAlignment="Left" Height="59" Margin="115,6,0,0" Grid.Row="1" VerticalAlignment="Top" Width="48" Source="/Basic_Ui_(235)-PhotoRoom.png-PhotoRoom.png"/>
            <Image HorizontalAlignment="Left" Height="47" Margin="420,51,0,0" Grid.Row="1" VerticalAlignment="Top" Width="52" Source="/istockphoto-587954006-170667a-PhotoRoom.png-PhotoRoom.png"/>
            <Image HorizontalAlignment="Left" Height="47" Margin="717,51,0,0" Grid.Row="1" VerticalAlignment="Top" Width="60" Source="/borrar-plugins-wordpress.png"/>

        </Grid>
    </Grid>
</Window>
