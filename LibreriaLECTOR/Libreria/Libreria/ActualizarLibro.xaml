<Window x:Class="Libreria.ActualizarLibro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="ActualizarLibro" Height="450" Width="800">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/madera.png"/>
        </Grid.Background>
        <Label x:Name="lbl_title_UpdateRead" Content="Actualizar Libro" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontFamily="Franklin Gothic Medium" FontSize="36" FontWeight="Bold" Height="57" Width="511"/>
        <Label x:Name="lbl_titulo" Content="Titulo:" HorizontalAlignment="Left" Margin="60,89,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="34" Width="133"/>
        <TextBox x:Name="txt_Titulo" HorizontalAlignment="Left" Margin="237,91,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="30"/>
        <Label x:Name="lbl_genero" Content="Genero:" HorizontalAlignment="Left" Margin="60,124,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="35" Width="243"/>
        <TextBox x:Name="txt_genero" HorizontalAlignment="Left" Margin="237,126,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="30"/>
        <Label x:Name="lbl_autor" Content="Autor: " HorizontalAlignment="Left" Margin="60,157,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="35" Width="259"/>
        <TextBox x:Name="txt_autor" HorizontalAlignment="Left" Margin="237,162,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="30"/>
        <Label x:Name="lbl_editorial" Content="Editorial:" HorizontalAlignment="Left" Margin="58,198,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="35" Width="293"/>
        <TextBox x:Name="txt_editorial" HorizontalAlignment="Left" Margin="237,200,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="29"/>
        <Label x:Name="lbl_cantidadPag" Content="Cantidad Paginas:" HorizontalAlignment="Left" Margin="54,241,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="34" Width="265"/>
        <TextBox x:Name="txt_cantidadPag" HorizontalAlignment="Left" Margin="237,242,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="30"/>
        <Label x:Name="lbl_cantidad" Content="Cantidad:" HorizontalAlignment="Left" Margin="54,276,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="34" Width="150"/>
        <TextBox x:Name="txt_cantidad" HorizontalAlignment="Left" Margin="237,279,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="451" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="30"/>
        <Button x:Name="btn_updateAceptar" Content="Aceptar" HorizontalAlignment="Left" Margin="195,340,0,43" Width="107" Background="#FF7FDBF5" BorderBrush="#FF09052D" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Click="btn_updateOk_reader_Click" />
        <Button x:Name="btn_updateCancelar" Content="Cancelar" HorizontalAlignment="Right" Margin="0,340,283,43" Width="149" Background="#FFF58C7F" BorderBrush="#FF2D0505" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Click="btn_updateCan_reader_Click" />
        <Image HorizontalAlignment="Left" Height="51" Margin="137,340,0,0" VerticalAlignment="Top" Width="58" Source="/istockphoto-587954006-170667a-PhotoRoom.png-PhotoRoom.png"/>
        <Image HorizontalAlignment="Left" Height="51" Margin="522,340,0,0" VerticalAlignment="Top" Width="62" Source="/Cnacelar.png"/>

    </Grid>
</Window>
