<Window x:Class="Libreria.ActualizaPrestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="ActualizaPrestamo" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="/madera.png"/>
        </Grid.Background>
        <Label x:Name="label_dias_Copy2" Content="Lector:" HorizontalAlignment="Left" Margin="35,195,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="55"/>
        <ListBox x:Name="lista_Lectores" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="37,230,558,89"/>
        <DatePicker x:Name="dp_fecha" HorizontalAlignment="Left" Margin="262,110,0,0" VerticalAlignment="Top" Height="27" Width="210"/>
        <Label Content="Fecha Inicial del préstamo" HorizontalAlignment="Left" Margin="216,78,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="190"/>
        <Label x:Name="label_dias" Content="Cantidad de días de duración del préstamo" HorizontalAlignment="Left" Margin="216,136,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="306"/>
        <TextBox x:Name="input_dias" HorizontalAlignment="Left" Margin="262,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" Height="23" />
        <Label Content="Actualizar Préstamo" HorizontalAlignment="Left" Margin="190,30,0,0" VerticalAlignment="Top" Height="48" Width="332" FontSize="36" FontFamily="Franklin Gothic Medium" FontWeight="Bold"/>
        <Label x:Name="label_dias_Copy3" Content="Seleccionar libro:" HorizontalAlignment="Left" Margin="264,198,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="126"/>
        <ListBox x:Name="lista_Libros" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="262,233,293,86"/>
        <Label x:Name="label_bibliotecario" Content="Bibliotecario:" HorizontalAlignment="Left" Margin="533,201,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="126"/>
        <ListBox x:Name="lista_Bib" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="533,237,22,88"/>
        <Button x:Name="Actualizar_Prestamo" Content="Actualizar" HorizontalAlignment="Left" Margin="254,379,0,0" VerticalAlignment="Top" Height="31" Width="115" Background="#FFAEF3FF" Click="Actualizar_Prestamo_Click" FontWeight="Bold"/>
        <Button x:Name="Borrar_Prestamo" Content="Cancelar" HorizontalAlignment="Left" Margin="404,380,0,0" VerticalAlignment="Top" Height="31" Width="115" Background="#FFFFAEAE" Click="Borrar_Prestamo_Click" FontWeight="Bold"/>
        <Button x:Name="btn_si" Content="" HorizontalAlignment="Left" Margin="717,0,0,0" VerticalAlignment="Top" Height="44" Width="15" BorderBrush="{x:Null}" Background="#FFC9C9C9" Click="btn_si_Click"/>
        <Image HorizontalAlignment="Left" Height="126" Margin="29,30,0,0" VerticalAlignment="Top" Width="158" Source="/sin letras-PhotoRoom.png-PhotoRoom.png"/>
        <Image HorizontalAlignment="Left" Height="126" Margin="561,30,0,0" VerticalAlignment="Top" Width="158" Source="/sin letras-PhotoRoom.png-PhotoRoom.png"/>
        <Image HorizontalAlignment="Left" Height="51" Margin="199,370,0,0" VerticalAlignment="Top" Width="58" Source="/istockphoto-587954006-170667a-PhotoRoom.png-PhotoRoom.png"/>
        <Image HorizontalAlignment="Left" Height="51" Margin="533,369,0,0" VerticalAlignment="Top" Width="62" Source="/Cnacelar.png"/>
    </Grid>
</Window>
