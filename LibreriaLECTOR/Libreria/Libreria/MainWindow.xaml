<Window x:Class="Libreria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="Prestamo Libro" Height="464" Width="800"
        Activated="Window_Activated">
    <Grid Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="187*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,0,87" Grid.ColumnSpan="2">
            <Menu DockPanel.Dock="Top" Height="361" Background="White">
                <MenuItem Header="Archivo" Background="White" Click="MenuItem_Click">
                    <MenuItem Header="Añadir Bibliotecario" Name="botonBibliotecario" Click="botonBibliotecario_Click" Background="#FFF7F7F7" />
                    <MenuItem Header="Añadir Lector" Name="botonLector" Click="botonLector_Click" Background="#FFF7F7F7" />
                    <MenuItem Header="Añadir Libro" Name="botonLibro" Click="botonLibro_Click" Background="#FFF7F7F7" />
                </MenuItem>
                <MenuItem Header="Ayuda" Name="botonAyudaS" Click="botonAyudaS_Click" Background="#FFF7F7F7" />
            </Menu>
        </DockPanel>

        <Grid Margin="0,22,0,10" Grid.ColumnSpan="2">
            <Grid.Background>
                <ImageBrush ImageSource="/madera.png"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28*"/>
                <ColumnDefinition Width="505*"/>
                <ColumnDefinition Width="264*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Préstamo de Libro" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="48" Width="332" FontSize="36" FontFamily="Franklin Gothic Medium" FontWeight="Bold" Grid.ColumnSpan="2"/>
            <DatePicker Name="dp_fecha" HorizontalAlignment="Left" Margin="62,90,0,0" VerticalAlignment="Top" Height="27" Width="210" Grid.Column="1"/>
            <Label HorizontalAlignment="Left" Margin="27,48,0,0" VerticalAlignment="Top" FontFamily="Franklin Gothic Medium" FontSize="18" Grid.Column="1" Height="10" Width="10"/>
            <Label Content="Fecha Inicial del préstamo" HorizontalAlignment="Left" Margin="17,58,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="1" Height="31" Width="190"/>
            <Label x:Name="label_dias" Content="Cantidad de días de duración del préstamo" HorizontalAlignment="Left" Margin="17,116,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="1" Height="31" Width="306"/>
            <TextBox x:Name="input_dias" HorizontalAlignment="Left" Margin="62,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" Height="23" Grid.Column="1" />
            <Label x:Name="label_dias_Copy2" Content="Lector:" HorizontalAlignment="Left" Margin="0,201,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="1" Height="31" Width="55"/>
            <Label x:Name="label_dias_Copy3" Content="Seleccionar libro:" HorizontalAlignment="Left" Margin="236,201,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="1" Height="31" Width="126"/>
            <ListBox x:Name="lista_prestamos" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="341,51,19,221" Grid.ColumnSpan="2" Grid.Column="1"/>
            <Button x:Name="register_borrow_Copy" Content="Registrar Préstamo" HorizontalAlignment="Left" Margin="27,373,0,0" VerticalAlignment="Top" Height="31" Width="115" Grid.Column="1" Background="#FFAEFFD9" Click="register_borrow_Copy_Click"/>
            <ListBox x:Name="lista_Lectores" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="2,237,298,70" Grid.Column="1"/>
            <ListBox x:Name="lista_Libros" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="234,237,26,70" Grid.Column="1"/>
            <Label x:Name="label_dias_Copy4" Content="Prestamos:" HorizontalAlignment="Left" Margin="344,18,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="1" Height="31" Width="85"/>
            <Button x:Name="Borrar_Prestamo" Content="Borrar Préstamo" HorizontalAlignment="Left" Margin="160,373,0,0" VerticalAlignment="Top" Height="31" Width="115" Grid.Column="1" Background="#FFFFAEAE" Click="Borrar_Prestamo_Click"/>
            <Button x:Name="Actualizar_Prestamo" Content="Actualizar Préstamo" HorizontalAlignment="Left" Margin="294,373,0,0" VerticalAlignment="Top" Height="31" Width="115" Grid.Column="1" Background="#FFAEF3FF" Click="Actualizar_Prestamo_Click"/>
            <Label x:Name="label_bibliotecario" Content="Bibliotecario:" HorizontalAlignment="Left" Margin="0,201,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Grid.Column="2" Height="31" Width="126"/>
            <ListBox x:Name="lista_Bib" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,237,19,70" Grid.Column="2"/>
            <Image Grid.Column="1" HorizontalAlignment="Left" Height="75" Margin="276,10,0,0" VerticalAlignment="Top" Width="65" Source="/sin letras-PhotoRoom.png-PhotoRoom.png"/>
        </Grid>
    </Grid>
</Window>
