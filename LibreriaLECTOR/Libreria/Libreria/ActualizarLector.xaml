<Window x:Class="Libreria.ActualizarLector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Libreria"
        mc:Ignorable="d"
        Title="ActualizarLector" Height="400" Width="400">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/madera.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        <Label x:Name="lbl_title_UpdateRead" Content="Actualizar Lector" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontFamily="Franklin Gothic Medium" FontSize="36" FontWeight="Bold" Height="51" Width="268"/>
        <Label x:Name="lbl_add_name" Content="Nombre:" HorizontalAlignment="Left" Margin="36,81,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="70"/>
        <TextBox x:Name="txtbx_add_reader_input" HorizontalAlignment="Left" Margin="111,83,0,0" TextWrapping="Wrap" Text="Nombre..." VerticalAlignment="Top" Width="255" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Label x:Name="lbl_add_lastname1" Content="Apellido Paterno:" HorizontalAlignment="Left" Margin="36,113,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="128"/>
        <TextBox x:Name="txtbx_add_readlast1_input" HorizontalAlignment="Left" Margin="167,115,0,0" TextWrapping="Wrap" Text="Paterno..." VerticalAlignment="Top" Width="199" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Label x:Name="lbl_add_lastname2" Content="Apellido Materno: " HorizontalAlignment="Left" Margin="36,143,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="136"/>
        <TextBox x:Name="txtbx_add_readlast2_input" HorizontalAlignment="Left" Margin="167,147,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="199" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Label x:Name="lbl_add_cellphone" Content="Número de Telefono:" HorizontalAlignment="Left" Margin="35,180,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="154"/>
        <TextBox x:Name="txtbx_add_readphone_input" HorizontalAlignment="Left" Margin="191,181,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="175" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Label x:Name="lbl_add_email" Content="Correo Electrónico:" HorizontalAlignment="Left" Margin="33,218,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="139"/>
        <TextBox x:Name="txtbx_add_reademail_input" HorizontalAlignment="Left" Margin="172,219,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="194" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Label x:Name="lbl_add_adress_Copy" Content="Domicilio:" HorizontalAlignment="Left" Margin="33,250,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="16" Height="31" Width="79"/>
        <TextBox x:Name="txtbx_add_readaddress_input" HorizontalAlignment="Left" Margin="117,251,0,0" TextWrapping="Wrap" Text="Agrega..." VerticalAlignment="Top" Width="249" FontStyle="Italic" Foreground="#FF373737" FontSize="16" BorderBrush="Black" Height="27"/>
        <Button x:Name="btn_updateOk_reader" Content="Listo" HorizontalAlignment="Left" Margin="107,308,0,30" Width="56" Background="#FF7FDBF5" BorderBrush="#FF09052D" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Click="btn_updateOk_reader_Click" />
        <Button x:Name="btn_updateCan_reader" Content="Cancelar" HorizontalAlignment="Right" Margin="0,308,124,30" Width="78" Background="#FFF58C7F" BorderBrush="#FF2D0505" BorderThickness="2,2,2,2" FontSize="14" FontWeight="Bold" Click="btn_updateCan_reader_Click" />
        <Image HorizontalAlignment="Left" Height="51" Margin="54,308,0,0" VerticalAlignment="Top" Width="58" Source="/istockphoto-587954006-170667a-PhotoRoom.png-PhotoRoom.png"/>
        <Image HorizontalAlignment="Left" Height="46" Margin="281,308,0,0" VerticalAlignment="Top" Width="56" Source="/Cnacelar.png"/>

    </Grid>
</Window>
